# Local development values only. Replace all three secrets before deployment.
MYSQL_DATABASE=secunda
MYSQL_USER=secunda
MYSQL_PASSWORD=local-development-password
MYSQL_ROOT_PASSWORD=local-development-root-password
JWT_SECRET=local-development-secret-replace-with-openssl-rand-hex-32
JWT_TTL=24h
HTTP_PORT=8080
HTTP_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
BCRYPT_COST=12
LOG_LEVEL=info
LOG_FORMAT=json
CACHE_TIMEOUT=150ms
CACHE_BREAKER_FAILURES=5
CACHE_BREAKER_TIMEOUT=10s
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=100
AUTH_RATE_LIMIT_RPS=1
AUTH_RATE_LIMIT_BURST=10
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_IDLE_TTL=10m
